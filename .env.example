# Copy this file to .env and adjust the values. Never commit .env.

APP_NAME="Ruang Kelas"
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# URL prefix under which public/ is served, e.g. /ruang-kelas/public. Leave empty to auto-detect.
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ruangkelas
# Use a dedicated MySQL user with privileges on this database only (never root).
DB_USERNAME=ruangkelas_app
DB_PASSWORD=change-me

SESSION_NAME=rk_session
# Idle timeout in seconds.
SESSION_LIFETIME=7200
# Force the Secure cookie flag (true/false). Leave empty to detect HTTPS automatically.
SESSION_SECURE=

# Anyone who enters this code on the registration form becomes a teacher.
# Leave empty to disable teacher self-registration entirely.
TEACHER_INVITE_CODE=
# Accept legacy plaintext passwords once and rehash them on the next successful login.
# Only enable temporarily while migrating an old database; prefer database/scripts/hash_legacy_passwords.php.
AUTH_ALLOW_LEGACY_PLAINTEXT=false
